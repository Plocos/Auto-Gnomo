{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Gnomo",
  "version": "0.1.0",
  "identifier": "local.autonomous.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @autonomous/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @autonomous/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auto-Gnomo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "api-runtime/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.154.0.4258.53.x64/"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDkwQUU4OTEyNEM0RkIKUldUN3hDU1I2QXJabFZaTFZZU2FQbHdOYVlHUGFpRURxZHBIKy94OTVCNGIrVmNyd29PUUEwdjMK",
      "endpoints": [
        "https://github.com/Plocos/Auto-Gnomo/releases/latest/download/latest.json"
      ]
    }
  }
}
